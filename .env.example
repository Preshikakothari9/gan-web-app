# Copy this file to .env for local overrides (not required to run locally).
# These are read directly from the environment — Flask does not auto-load
# .env files here, so either `export` them yourself or use a tool like
# python-dotenv / `honcho` if you want file-based loading.

# Port the Flask/gunicorn server binds to. Render sets this automatically.
PORT=5000

# Comma-separated list of allowed origins for the /api/* routes, e.g.
# CORS_ORIGINS=https://your-frontend.example.com
# Defaults to "*" (open) which is fine for local dev and for the default
# setup where this Flask app also serves the frontend itself (same-origin
# requests don't need CORS at all).
CORS_ORIGINS=*

# Set to "true" to enable Flask's debug/reload mode locally. Never enable
# in production.
FLASK_DEBUG=false
